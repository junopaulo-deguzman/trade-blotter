DATABASE_URL=postgres://trading:local-development-only@localhost:5432/trading
PORT=3000
# Set to 1 only when the API is exclusively behind one trusted reverse proxy.
TRUST_PROXY=0

# Comma-separated exact browser origins. Required in production.
WS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# Optional: supply your own password (12+ characters) to enable seed-recorder.
# Leave empty to retain disabled login. Never commit the real password.
SEED_RECORDER_PASSWORD=
